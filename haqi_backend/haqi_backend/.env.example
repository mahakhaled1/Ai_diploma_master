# PostgreSQL Production / Local Database URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/haqi_db

# Automatic SQLite fallback when PostgreSQL is not running locally
SQLITE_FALLBACK_PATH=./haqi_local.db

# Application Settings
APP_NAME="HAQI | حقي — المساعد الذكي للخدمات والحقوق العامة"
APP_VERSION="1.0.0"
DEBUG=True
PORT=8000

# Evidence Validation & Safe Abstention Thresholds (Maha & Hassan)
MIN_RELEVANCE_SCORE=0.35
MIN_GROUNDING_SCORE=0.60
MAX_DOC_AGE_DAYS=730
REQUIRE_OFFICIAL_AUTHORITY=True

# Optional External LLM Configuration (Hassan's RAG Module)
LLM_PROVIDER=extractive_grounded
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
